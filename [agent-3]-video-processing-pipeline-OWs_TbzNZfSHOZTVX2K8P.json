{"updatedAt":"2026-03-25T20:53:34.852Z","createdAt":"2026-02-20T17:31:55.077Z","id":"OWs_TbzNZfSHOZTVX2K8P","name":"[AGENT-3]-Video-Processing-Pipeline","active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":12}]}},"id":"963e7cf3-4dfb-4e73-9755-8d2b9300af97","name":"schedule-trigger-15min","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[6208,8272]},{"parameters":{},"type":"n8n-nodes-globals.globalConstants","typeVersion":1,"position":[6432,8272],"id":"b1ee356e-9664-4e2b-8d7a-357a6a8b7071","name":"Global Constants","credentials":{"globalConstantsApi":{"id":"YeLbhL4kruFCcaXX","name":"vizard"}}},{"parameters":{"operation":"select","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"videos_pendentes","mode":"list","cachedResultName":"videos_pendentes"},"limit":3,"where":{"values":[{"column":"status","value":"pendente"}]},"sort":{"values":[{"column":"created_at"}]},"options":{}},"id":"5f21acf7-0a39-452d-b97c-3c3d7c105e0d","name":"fetch-pending-videos","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[6880,8272],"credentials":{"postgres":{"id":"PP028pDoSCi5j2TS","name":"[CRED]POSTGRES-SUPABASE"}}},{"parameters":{"operation":"executeQuery","query":"-- 1) Descarta curtos automaticamente\nUPDATE videos_pendentes\nSET status = 'erro',\n    erro_mensagem = 'Descartado automatico: duracao menor que 60 segundos',\n    updated_at = NOW()\nWHERE status = 'pendente'\n  AND duracao_segundos < 60;\n\n-- 2) Recupera itens presos sem projectId para reprocessar\nUPDATE videos_pendentes\nSET status = 'pendente',\n    erro_mensagem = COALESCE(erro_mensagem, 'Reenfileirado automaticamente: travado em em_processamento sem projectId'),\n    updated_at = NOW()\nWHERE status = 'em_processamento'\n  AND (vizard_project_id IS NULL OR vizard_project_id = '')\n  AND updated_at < NOW() - INTERVAL '20 minutes';","options":{}},"id":"181d0338-c4a7-4a41-97a0-13f04c12fccf","name":"discard-short-videos","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[6656,8272],"alwaysOutputData":true,"credentials":{"postgres":{"id":"PP028pDoSCi5j2TS","name":"[CRED]POSTGRES-SUPABASE"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"video-exists","leftValue":"={{ $json.id }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}}],"combinator":"and"},"options":{}},"id":"318d1b83-e075-42d7-9ea0-552c2489d94b","name":"if-has-pending-videos","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[7104,8272]},{"parameters":{"operation":"executeQuery","query":"SELECT \n  COUNT(*) FILTER (WHERE status = 'concluido') AS videos_done,\n  COUNT(*) FILTER (WHERE status = 'erro') AS videos_error,\n  COUNT(*) FILTER (WHERE status = 'pendente') AS videos_remaining,\n  COUNT(*) FILTER (WHERE status = 'em_processamento') AS videos_processing,\n  COUNT(*) FILTER (WHERE status = 'erro' AND erro_mensagem LIKE 'Descartado automatico:%') AS videos_descartados\nFROM videos_pendentes\nWHERE created_at >= NOW() - INTERVAL '1 day';","options":{}},"id":"99922912-e3a4-498e-b286-506941582b25","name":"fetch-pipeline-summary","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[7552,7648],"credentials":{"postgres":{"id":"PP028pDoSCi5j2TS","name":"[CRED]POSTGRES-SUPABASE"}}},{"parameters":{"options":{}},"id":"638ac451-d8fa-48bf-805e-fc3435be6112","name":"loop-by-video","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[7328,8176]},{"parameters":{},"id":"1aa78bee-3b6d-4920-ae35-14923c6e0451","name":"no-pending-videos","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[7328,8368]},{"parameters":{"operation":"executeQuery","query":"UPDATE videos_pendentes \nSET status = 'em_processamento',\n    updated_at = NOW()\nWHERE id = '{{ $json.id }}'\n  AND status = 'pendente'\nRETURNING id;","options":{}},"id":"3571e3fc-a755-4c1f-a117-1dfd2509651d","name":"mark-video-processing","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[7552,7872],"credentials":{"postgres":{"id":"PP028pDoSCi5j2TS","name":"[CRED]POSTGRES-SUPABASE"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"lock-acquired","leftValue":"={{ $json.id }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}}],"combinator":"and"},"options":{}},"id":"947d1dc3-8ce8-4d80-903f-95346a4a0669","name":"if-lock-acquired","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[7776,7840]},{"parameters":{"jsCode":"// Define preferLength baseado na duração do vídeo\n// 0 = 15-30s | 1 = 30-60s | 2 = 60-90s | 3 = 90s+\nconst video = $('loop-by-video').item.json;\nconst durSec = video.duracao_segundos || 0;\nconst durMin = durSec / 60;\n\nlet preferLength = [0, 1]; // default: 15s a 60s\n\nif (durMin >= 10) {\n  preferLength = [0, 1, 2, 3]; // longo: todos os tamanhos\n} else if (durMin >= 5) {\n  preferLength = [0, 1, 2]; // médio: até 90s\n} else if (durMin >= 2) {\n  preferLength = [0, 1]; // curto: até 60s\n} else {\n  preferLength = [0]; // muito curto: só 15-30s\n}\n\nreturn [{ json: {\n  ...video,\n  preferLength\n} }];"},"id":"7237c584-926f-4c62-9b52-5b9a30056c45","name":"build-vizard-params","type":"n8n-nodes-base.code","typeVersion":2,"position":[8000,7840]},{"parameters":{"method":"POST","url":"https://elb-api.vizard.ai/hvizard-server-front/open-api/v1/project/create","sendHeaders":true,"headerParameters":{"parameters":[{"name":"VIZARDAI_API_KEY","value":"={{ $('Global Constants').item.json.constants.API_KEY }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ {\n  lang: 'pt',\n  preferLength: Array.isArray($json.preferLength) ? $json.preferLength : [0,1],\n  videoUrl: String($json.url_video || ''),\n  videoType: 2\n} }}","options":{"timeout":300000}},"id":"4f3e0d20-075f-4b1f-8348-d4c633e566e8","name":"call-vizard-api","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[8224,7840],"onError":"continueErrorOutput"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"has-project-id","leftValue":"={{ $json.projectId }}","rightValue":"","operator":{"type":"number","operation":"exists","singleValue":true}}],"combinator":"and"},"options":{}},"id":"bbdb651f-a292-4010-a6d5-f8fc6ce85c45","name":"if-vizard-success","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[8448,7776]},{"parameters":{"operation":"executeQuery","query":"UPDATE videos_pendentes \nSET \n  vizard_code = '{{ $json.code }}',\n  vizard_project_id = '{{ $json.projectId }}',\n  status = 'em_processamento',\n  updated_at = NOW()\nWHERE id = '{{ $('loop-by-video').item.json.id }}';","options":{}},"id":"3eeed845-a981-42ca-a8cb-d2fa0c23d015","name":"save-vizard-project","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[8672,7680],"credentials":{"postgres":{"id":"PP028pDoSCi5j2TS","name":"[CRED]POSTGRES-SUPABASE"}}},{"parameters":{"operation":"executeQuery","query":"UPDATE videos_pendentes \nSET \n  status = 'erro',\n  erro_mensagem = 'Vizard API: sem projectId na resposta — {{ $json.message ?? $json.error ?? \"resposta inválida\" }}',\n  updated_at = NOW()\nWHERE id = '{{ $('loop-by-video').item.json.id }}';","options":{}},"id":"ad6d2067-bfe2-4fed-84f9-77873b56c5ee","name":"mark-video-error","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[8672,7872],"credentials":{"postgres":{"id":"PP028pDoSCi5j2TS","name":"[CRED]POSTGRES-SUPABASE"}},"onError":"continueRegularOutput"},{"parameters":{"operation":"executeQuery","query":"UPDATE videos_pendentes \nSET \n  status = 'erro',\n  erro_mensagem = 'Vizard API HTTP error — {{ $json.error ?? $json.message ?? \"timeout ou falha de rede\" }}',\n  updated_at = NOW()\nWHERE id = '{{ $('loop-by-video').item.json.id }}';","options":{}},"id":"82829161-1f55